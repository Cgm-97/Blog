---
import { getConfig } from '../config';
import { theme } from '../theme';
import MenuItem from './header/menu_item.astro';
import { getBlogEntry, getCategoryList } from '@src/prework';

const config = getConfig();

const blogLength: number = (await getBlogEntry()).length;
const categoryLength: number = (await getCategoryList()).length;
const tagLength: number = 0;
---

<div id="sidebar">
  <div id="menu-mask"></div>
  <div id="sidebar-menus">
    <div class="avatar-img text-center my-5 mx-auto">
      <img src={theme.avatar.img} onerror={`this.onerror=null;this.src='${theme.error_img.flink}'`} alt="avatar" />
    </div>
    <div class="site-data text-center px-[10px]">
      <a href={`/${config.archive_dir}/`}>
        <div class="headline">Articles</div>
        <div class="length-num">{blogLength}</div>
      </a>
      <a href={`/${config.tag_dir}/`}>
        <div class="headline">Tags</div>
        <div class="length-num">{tagLength}</div>
      </a>
      <a href={`/${config.category_dir}/`}>
        <div class="headline">Categories</div>
        <div class="length-num">{categoryLength}</div>
      </a>
    </div>
    <MenuItem />
  </div>
</div>