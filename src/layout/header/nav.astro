---
import { theme } from '@src/theme';
import { getConfig } from '@src/config';
import MenuItem from './menu_item.astro';
import { is_post } from '@src/utils';

const config = getConfig();
const isPost = is_post(Astro.url);
---

<nav id="nav" class="show absolute top-0 z-[90] flex items-center w-full h-[60px] text-[1.3em] opacity-0 px-[36px] max-md:px-4 transition-all duration-500">
  <span id="blog-info" class="flex-1" style="color: var(--light-grey);">
    <a class="nav-site-title" href={`/`}>
      {theme.nav.logo && (
        <img class="site-icon" src={theme.nav.logo} alt="Logo" />
      )}
      {theme.nav.display_title && (
        <span class="site-name">{config.title}</span>
      )}
    </a>
    {isPost && (
      // <a class="nav-page-title" href={url_for('/')}>
      <a class="nav-page-title" href={`/`}>
        {/* <span class="site-name">{page.title || config.title}</span> */}
        <span class="site-name">{config.title}</span>
      </a>
    )}
  </span>
  <div id="menus">
    <div id="search-button" class="cursor-pointer">
      <span class="site-page social-icon search">
        <i class="fas fa-search fa-fw"></i>
        <span class="hidden md:inline">Search</span>
      </span>
    </div>
    <MenuItem />
    <div id="toggle-menu">
      <span class="site-page">
        <i class="fas fa-bars fa-fw"></i>
      </span>
    </div>
  </div>
</nav>