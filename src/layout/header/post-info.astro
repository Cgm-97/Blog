---
import { date, date_xml, full_date } from '@src/utils';
import { theme } from '@src/theme';
import { getConfig } from '@src/config';

interface Props { page: Record<string, any>; }
const { page } = Astro.props;
const config = getConfig();
---

<div id="post-info">
  <h1 class="post-title">{page.title || 'Untitled'}</h1>

  <div id="post-meta">
    <div class="meta-firstline">
      <span class="post-meta-date">
        <i class="far fa-calendar-alt fa-fw post-meta-icon"></i>
        <span class="post-meta-label">Created</span>
        <time class="post-meta-date-created" datetime={date_xml(page.date)} title={`Created ${full_date(page.date)}`}>
          {date(page.date, config.date_format)}
        </time>
        <span class="post-meta-separator"> | </span>
        <i class="fas fa-history fa-fw post-meta-icon"></i>
        <span class="post-meta-label">Updated</span>
        <time class="post-meta-date-updated" datetime={date_xml(page.updated)} title={`Updated ${full_date(page.updated)}`}>
          {date(page.updated, config.date_format)}
        </time>
      </span>
    </div>

    <div class="meta-secondline">
      <span class="post-meta-separator"> | </span>
      <span class="post-meta-wordcount">
        <i class="far fa-file-word fa-fw post-meta-icon"></i>
        <span class="post-meta-label">Words:</span>
        <span id="word-count">–</span>
        <span class="post-meta-separator"> | </span>
        <i class="far fa-clock fa-fw post-meta-icon"></i>
        <span class="post-meta-label">Read:</span>
        <span id="read-time">–</span>
      </span>

      <span class="post-meta-separator"> | </span>
      <span class="post-meta-pv-cv">
        <i class="far fa-eye fa-fw post-meta-icon"></i>
        <span class="post-meta-label">Views:</span>
        <span id="pv-count">–</span>
      </span>
    </div>
  </div>
</div>

<script>
  const container = document.getElementById('article-container');
  if (container) {
    const text = container.innerText || '';
    const cjkCount = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
    const wordCount = (text.match(/[A-Za-z0-9_]+/g) || []).length;
    const totalCount = cjkCount + wordCount;

    const wordCountEl = document.getElementById('word-count');
    if (wordCountEl) wordCountEl.textContent = totalCount.toLocaleString();

    const readTimeEl = document.getElementById('read-time');
    if (readTimeEl) {
      const minutes = Math.max(1, Math.round(totalCount / 300));
      readTimeEl.textContent = `${minutes} min`;
    }
  }

  const GOATCOUNTER_CODE = 'cgm97';

  const pvEl = document.getElementById('pv-count');
  if (pvEl) {
    fetch(`https://${GOATCOUNTER_CODE}.goatcounter.com/counter/${encodeURIComponent(location.pathname)}.json`)
      .then((res) => res.json())
      .then((data) => {
        pvEl.textContent = data.count || '0';
      })
      .catch(() => {
        pvEl.textContent = '–';
      });
  }
</script>
