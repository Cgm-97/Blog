---
import type { SiteConfig } from '@src/types';
import { theme } from '@src/theme';

interface Props { config: SiteConfig; }
const { config } = Astro.props;

let localSearch = 'undefined';
let translate = 'undefined';
let copyright = 'undefined';
let noticeOutdate = 'undefined';
let highlight = 'undefined';

const GLOBAL_CONFIG = {
    root: config.root,
    algolia: undefined,
    localSearch: localSearch,
    translate: translate,
    noticeOutdate: noticeOutdate,
    highlight: highlight,
    copy: {
        success: "Copied successfully!",
        error: "Copy failed",
        noSupport: "Browser does not support copy"
    },
    relativeDate: {
        homepage: theme.post_meta.page.date_format === 'relative',
        post: theme.post_meta.post.date_format === 'relative'
    },
    runtime: theme.aside.card_webinfo.runtime_date ? " Days" : "",
    dateSuffix: {
        just: "Just now",
        min: " mins ago",
        hour: " hours ago",
        day: " days ago",
        month: " months ago"
    },
    copyright: copyright,
    infinitegrid: {
        buttonText: "Load More"
    },
    isPhotoFigcaption: theme.photofigcaption,
    islazyload: theme.lazyload.enable,
    isAnchor: false,
    percent: {
        toc: theme.toc.scroll_percent,
        rightside: theme.rightside_scroll_percent,
    },
};
---

<script is:inline define:vars={{ GLOBAL_CONFIG }}>
  window.GLOBAL_CONFIG = GLOBAL_CONFIG;
</script>