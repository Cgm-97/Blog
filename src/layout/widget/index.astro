---
import type { PostHeading } from '@src/types';
import CardAuthor from './card_author.astro'; 
import CardAnnouncement from './card_announcement.astro';
import CardTags from './card_tags.astro';
import CardPostToc from './card_post_toc.astro';
import { is_post } from '@src/utils';

interface Props { 
  postHeadings?: PostHeading[]; 
}

const { postHeadings } = Astro.props;
const showToc = true;
const isPost = is_post(Astro.url);
---

<div id="aside-content" class="aside-content w-[24%] max-[900px]:mt-5 max-[900px]:w-full">
    <CardAuthor />
    <CardAnnouncement />
    <CardTags />
    <div class="sticky_layout transition-[top] duration-300 min-[900px]:sticky min-[900px]:top-[15px]">
      {showToc && isPost && <CardPostToc postHeadings={postHeadings}/>}
    </div>
</div>