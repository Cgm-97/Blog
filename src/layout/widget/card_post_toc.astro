---
import type { PostHeading } from '@src/types';

interface Props {
  postHeadings?: PostHeading[];
}
const { postHeadings } = Astro.props;
import CardPostTocItems from './card_post_toc_items.astro';
---

<div id="card-toc" class="card-widget" style="margin-left: 10px; margin-right: 4px; width: calc(100% - 14px); transform: translateX(20px);">
  <div class="item-headline">
    <span>Contents</span>
    <span class="toc-percentage"></span>
  </div>
  <CardPostTocItems postHeadings={postHeadings} />
</div>