---
import { getConfig } from '@src/config';
const config = getConfig();
---

<div class="card-widget card-announcement" style="margin-left: 10px; margin-right: 4px; width: calc(100% - 14px); transform: translateX(20px);">
  <div class="item-headline pb-[6px] text-[1.2em]">
    <span>Special Note</span>
  </div>
  <div class="announcement_content">
    {config.aside.card_announcement.content.split('\n').map((line: string) => (
      <p set:html={line}></p>
    ))}
  </div>
</div>
