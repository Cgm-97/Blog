---
import Layout from './layout.astro';

interface Props { frontmatter: Record<string, any>; }
const { frontmatter } = Astro.props;
const page = {
  title: frontmatter.title,
  type: "page",
  comments: false
}
import Comments from './third-party/comments.astro';

---
<Layout page={page}>
    <div id="page" class={''}>
        <div id="article-container">
            <slot />
        </div>
        <Comments />
    </div>
</Layout>