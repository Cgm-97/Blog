---
import type { Page } from 'astro';
import { theme } from '@src/theme';
import { date_xml, full_date, date } from '@src/utils';
import { getConfig } from '@src/config';
import Pagination from '../pagination.astro';

interface Props { postsPagnition: Page; }
const { postsPagnition } = Astro.props;
const config = getConfig();
const postsMeta = postsPagnition.data;
---
<div id="recent-posts" class={`recent-posts nc`}>
    {postsMeta.map((entry, index) => {
      const link = `/posts/${entry.abbrlink}`;
      const title = entry.title;
      const leftOrRight = (index % 2 === 0 ? 'left' : 'right');
      const post_cover = entry.cover;
      const no_cover = '';

      return (
        <div class="recent-post-item">
          {post_cover && (
            <div class={`post_cover ${leftOrRight}`}>
              <a href={link} title={title}>
                <img
                    class="post-bg"
                    src={post_cover}
                    onerror={`this.onerror=null;this.src='${theme.error_img.post_page}'`}
                    alt={title}
                  />
              </a>
            </div>
          )}
          <div class={`recent-post-info ${no_cover}`}>
            <a class="article-title" href={link} title={title}>
              {title}
            </a>
            <div class="article-meta-wrap">
              <span class="post-meta-date">
                <i class="far fa-calendar-alt"></i>
                <span class="article-meta-label">Created</span>
                <time class="post-meta-date-created" datetime={date_xml(entry.date)} title={`Created ${full_date(entry.date)}`}>
                  {date(entry.date, config.date_format)}
                </time>
              </span>
              <span class="article-meta">
                <span class="article-meta-separator"> | </span>
                <i class="fas fa-inbox"></i>
                <a href={`/categories/${encodeURIComponent(entry.categories)}`} class="article-meta__categories">{entry.categories}</a>
              </span>
            </div>
            <div class="content">{entry.description}</div>
          </div>
        </div>
      );
    })}
    <Pagination page={postsPagnition}/>
</div>
