---
import Layout from '@src/layout/layout.astro';
import { getTagList } from '@src/prework';

const tags = await getTagList();

const page = {
  title: 'Tags',
  type: 'tags',
  comments: false
};
---

<Layout page={page}>
  <div id="page">
    <div class="tag-cloud-title">Tags</div>
    <div id="tags-list">
      {tags.map(tag => (
        <a href={tag.path} style={`font-size: ${0.95 + Math.min(tag.count, 8) * 0.08}rem;`}>
          {tag.name}
        </a>
      ))}
    </div>
  </div>
</Layout>