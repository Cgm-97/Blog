---
import Layout from '@src/layout/layout.astro';
import { getCollection, render } from 'astro:content';
import Comments from '@src/layout/third-party/comments.astro';

const boardEntries = await getCollection('about');
const boardEntry = boardEntries[0];

const page = {
  title: 'About',
  type: 'board',
  comments: true
};

const boardContent = boardEntry ? await render(boardEntry) : null;
const BoardContent = boardContent?.Content;
---

<Layout page={page}>
  <div id="page">
    <div id="article-container">
      {BoardContent ? (
        <BoardContent />
      ) : (
        <div class="markdown-content">
          <h1>About</h1>
          <p>Welcome to my blog.</p>
          <p>I write about cybersecurity, software development, and hardware design.</p>
          <p>Feel free to explore the posts, archive, and links.</p>
        </div>
      )}
    </div>
    <Comments />
  </div>
</Layout>