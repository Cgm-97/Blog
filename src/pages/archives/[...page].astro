---
import Layout from '@src/layout/layout.astro';
import ArticleSort from '@src/layout/mixins/article-sort.astro';
import Pagination from '@src/layout/pagination.astro';
import { getBlogEntry, getArchiveLength } from '@src/prework';

export async function getStaticPaths({ paginate }: any) {
  const blogEntries = await getBlogEntry();
  return paginate(blogEntries, {
    pageSize: 10,
    routePattern: `/archives/[...page]`,
    slugFormatter: (page: number) => (page > 1 ? `${page}` : undefined)
  });
}

const { page } = Astro.props as { page: any };
const pageSetting = {
  title: 'Archives',
  type: 'archives',
  comments: false
};
const archiveLength = await getArchiveLength();
---

<Layout page={pageSetting}>
  <div id="archive">
    <div class="article-sort-title">{`Articles - ${archiveLength}`}</div>
    <ArticleSort posts={page.data}/>
    <Pagination page={page}/>
  </div>
</Layout>