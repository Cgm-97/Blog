---
import Layout from '@src/layout/layout.astro';
import ArticleSort from '@src/layout/mixins/article-sort.astro';
import Pagination from '@src/layout/pagination.astro';
import { getBlogEntry, getCategoryList } from '@src/prework';

export async function getStaticPaths({ paginate }: any) {
  const categories = await getCategoryList();
  const blogEntries = await getBlogEntry();
  const paths = [];
  const POSTS_PER_PAGE = 10;

  for (const category of categories) {
    const categoryPosts = blogEntries.filter(
      entry => entry.data.categories === category.name
    );

    paths.push(
      ...paginate(categoryPosts, {
        params: { category: encodeURIComponent(category.name) },
        props: { category: category.name },
        pageSize: POSTS_PER_PAGE,
        routePattern: `/categories/${encodeURIComponent(category.name)}/[...page]`,
        slugFormatter: (page: number) =>
          page > 1 ? `${page}` : undefined
      })
    );
  }
  return paths;
}

const { category, page } = Astro.props;
const decodedCategory = decodeURIComponent(category);
const pageSettings = {
  title: `Category: ${decodedCategory}`,
  type: 'categories',
  comments: false
};
---

<Layout page={pageSettings}>
    <div id="category">
      <div class="article-sort-title">{'Category - ' + decodedCategory}</div>
      <ArticleSort posts={page.data}/>
      <Pagination page={page}/>
    </div>
</Layout>