---
import Layout from '@src/layout/layout.astro';
import ArticleSort from '@src/layout/mixins/article-sort.astro';
import { getBlogEntry, getArchiveLength } from '@src/prework';
import { useTranslations } from '@src/utils';

const lang = 'en';
const t = useTranslations(lang);
const blogEntries = await getBlogEntry(lang);
const archiveLength = await getArchiveLength(lang);

const page = {
  title: 'Categories',
  type: 'categories',
  comments: false
};
---

<Layout lang={lang} page={page}>
  <div id="archive">
    <div class="article-sort-title">{`Categories - ${archiveLength}`}</div>
    <ArticleSort lang={lang} posts={blogEntries} />
  </div>
</Layout>
